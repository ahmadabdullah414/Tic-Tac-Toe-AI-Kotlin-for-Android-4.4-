<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".TicTacToeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TicTacToe">

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.TicTacToe.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainMenuActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AIDifficultyActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TwoPlayerGameActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AIGameActivity"
            android:exported="false" />

        <activity
            android:name=".ui.MatchHistoryActivity"
            android:exported="false" />

    </application>
</manifest>
