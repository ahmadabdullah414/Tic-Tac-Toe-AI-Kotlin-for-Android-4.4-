<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TicTacToe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_purple</item>
        <item name="colorPrimaryDark">@color/brand_purple</item>
        <item name="colorAccent">@color/brand_indigo</item>
        <item name="android:windowBackground">@drawable/bg_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:statusBarColor">@color/color_scaffold_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.TicTacToe.Splash" parent="Theme.TicTacToe">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

</resources>
